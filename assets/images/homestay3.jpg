>Date</span><span>(</span><span class="ͼe">checkin</span><span>);</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d2</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkout</span><span>);</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">nights</span><span class="ͼ8">=</span><span>(</span><span class="ͼe">d2</span><span class="ͼ8">-</span><span class="ͼe">d1</span><span>)</span><span class="ͼ8">/</span><span>(</span><span class="ͼb">1000</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">24</span><span>);</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼe">nights</span><span class="ͼ8">&lt;=</span><span class="ͼb">0</span><span>){</span><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Ngày checkout phải sau checkin"</span><span>);</span><br><span class="ͼ8">return</span><span>;</span><br><span>}</span><br><br><span class="ͼ6">// lưu vào Google Sheet</span><br><br><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>mode:</span><span class="ͼc">"no-cors"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify({</span><br><span>ten:</span><span class="ͼe">ten</span><span>,</span><br><span>checkin:</span><span class="ͼe">checkin</span><span>,</span><br><span>checkout:</span><span class="ͼe">checkout</span><span>,</span><br><span>khach:</span><span class="ͼe">khach</span><span>,</span><br><span>dem:</span><span class="ͼe">nights</span><br><span>})</span><br><span>});</span><br><br><span class="ͼ6">// tạo message</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">message</span><span class="ͼ8">=</span><span class="ͼc">`Xin chào Homestay Hà Nội</span><br><br><span class="ͼc">Tên: </span><span>${</span><span class="ͼe">ten</span><span>}</span><br><span class="ͼc">Checkin: </span><span>${</span><span class="ͼe">checkin</span><span>}</span><br><span class="ͼc">Checkout: </span><span>${</span><span class="ͼe">checkout</span><span>}</span><br><span class="ͼc">Số khách: </span><span>${</span><span class="ͼe">khach</span><span>}</span><br><span class="ͼc">Số đêm: </span><span>${</span><span class="ͼe">nights</span><span>}</span><span class="ͼc">`</span><span>;</span><br><br><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"ketqua"</span><span>)</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">`</span><br><br><span class="ͼc">&lt;p&gt;&lt;b&gt;Thông tin đặt phòng&lt;/b&gt;&lt;/p&gt;</span><br><br><span class="ͼc">&lt;textarea id="msgbox"&gt;</span><span>${</span><span class="ͼe">message</span><span>}</span><span class="ͼc">&lt;/textarea&gt;</span><br><br><span class="ͼc">&lt;button onclick="copyMsg()"&gt;Copy nội dung&lt;/button&gt;</span><br><br><span class="ͼc">&lt;button onclick="openZalo()"&gt;Mở Zalo gửi&lt;/button&gt;</span><br><br><span class="ͼc">`</span><span>;</span><br><br><span>});</span><br><br><span class="ͼ8">function</span><span> </span><span class="ͼe">copyMsg</span><span>(){</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">text</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"msgbox"</span><span>);</span><br><br><span class="ͼe">text</span><span class="ͼ8">.</span><span>select();</span><br><br><span class="ͼe">navigator</span><span class="ͼ8">.</span><span>clipboard</span><span class="ͼ8">.</span><span>writeText(</span><span class="ͼe">text</span><span class="ͼ8">.</span><span>value);</span><br><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Đã copy nội dung"</span><span>);</span><br><