pan class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"container"</span><span class="ͼg">&gt;</span><br><span class="ͼg">&lt;div</span><span> </span><span class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"card"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;h1&gt;</span><span>🏡 Homestay Hà Nội</span><span class="ͼg">&lt;/h1&gt;</span><br><span class="ͼg">&lt;p</span><span> </span><span class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"subtitle"</span><span class="ͼg">&gt;</span><span>Điền thông tin để kiểm tra phòng trống</span><span class="ͼg">&lt;/p&gt;</span><br><br><span class="ͼg">&lt;div</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"error"</span><span> </span><span class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"error"</span><span class="ͼg">&gt;&lt;/div&gt;</span><br><br><span class="ͼg">&lt;label&gt;</span><span>Tên của bạn</span><span class="ͼg">&lt;/label&gt;</span><br><span class="ͼg">&lt;input</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"name"</span><span> </span><span class="ͼf">placeholder</span><span class="ͼ8">=</span><span class="ͼc">"Ví dụ: Nguyễn Minh"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;label&gt;</span><span>Ngày check-in</span><span class="ͼg">&lt;/label&gt;</span><br><span class="ͼg">&lt;input</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"checkin"</span><span> </span><span class="ͼf">type</span><span class="ͼ8">=</span><span class="ͼc">"date"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;label&gt;</span><span>Số khách</span><span class="ͼg">&lt;/label&gt;</span><br><span class="ͼg">&lt;input</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"guests"</span><span> </span><span class="ͼf">type</span><span class="ͼ8">=</span><span class="ͼc">"number"</span><span> </span><span class="ͼf">placeholder</span><span class="ͼ8">=</span><span class="ͼc">"Ví dụ: 2"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;button</span><span> </span><span class="ͼf">onclick</span><span class="ͼ8">=</span><span class="ͼc">"</span><span class="ͼe">sendZalo</span><span>()</span><span class="ͼc">"</span><span class="ͼg">&gt;</span><span>Kiểm tra phòng</span><span class="ͼg">&lt;/button&gt;</span><br><br><span class="ͼg">&lt;p</span><span> </span><span class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"note"</span><span class="ͼg">&gt;</span><br><span>Sau khi bấm nút, Zalo sẽ mở để gửi thông tin cho homestay.</span><br><span class="ͼg">&lt;/p&gt;</span><br><br><span class="ͼg">&lt;/div&gt;</span><br><span class="ͼg">&lt;/div&gt;</span><br><br><span class="ͼg">&lt;script&gt;</span><br><br><span class="ͼ8">function</span><span> </span><span class="ͼe">sendZalo</span><span>(){</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">name</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"name"</span><span>)</span><span class="ͼ8">.</span><span>value</span><span class="ͼ8">.</span><span>trim()</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkin</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkin"</span><span>)</span><span class="ͼ8">.</span><span>value</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">guests</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"guests"</span><span>)</span><span class="ͼ8">.</span><span>value</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">error</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"error"</span><span>)</span><br><span class="ͼe">error</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">""</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼ8">!</span><span class="ͼe">name</span><span> </span><span class="ͼ8">||</span><span> </span><span class="ͼ8">!</span><span class="ͼe">checkin</span><span> </span><span class="ͼ8">||</span><span> </span><span class="ͼ8">!</span><span class="ͼe">guests</span><span>){</span><br><span>  </span><span class="ͼe">error</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">"Vui lòng điền đầy đủ thông tin."</span><br><span>  </span><span class="ͼ8">return</span><br><span>}</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">message</span><span> </span><span class="ͼ8">=</span><br><span class="ͼc">"Xin chào Homestay, tôi muốn kiểm tra phòng:%0A%0A"</span><span> </span><span class="ͼ8">+</span><br><span class="ͼc">"Tên: "</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼe">name</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼc">"%0A"</span><span> </span><span class="ͼ8">+</span><br><span class="ͼc">"Checkin: "</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼe">checkin</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼc">"%0A"</span><span> </span><span class="ͼ8">+</span><br><span class="ͼc">"Số khách: "</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼe">guests</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">zaloLink</span><span> </span><span class="ͼ8">=</span><br><span class="ͼc">"https://zalo.me/YOUR_ZALO_NUMBER?text="</span><span> </span><span class="ͼ8">+</span><span> </span><span class="ͼe">message</span><br><br><span class="