document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"nights"</span><span>)</span><span class="ͼ8">.</span><span>innerText</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">error</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"error"</span><span>)</span><br><span class="ͼe">error</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">""</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼ8">!</span><span class="ͼe">name</span><span class="ͼ8">||!</span><span class="ͼe">phone</span><span class="ͼ8">||!</span><span class="ͼe">checkin</span><span class="ͼ8">||!</span><span class="ͼe">checkout</span><span class="ͼ8">||!</span><span class="ͼe">guests</span><span>){</span><br><span class="ͼe">error</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">"Vui lòng điền đầy đủ thông tin"</span><br><span class="ͼ8">return</span><br><span>}</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">data</span><span class="ͼ8">=</span><span>{</span><br><span>name:</span><span class="ͼe">name</span><span>,</span><br><span>phone:</span><span class="ͼe">phone</span><span>,</span><br><span>checkin:</span><span class="ͼe">checkin</span><span>,</span><br><span>checkout:</span><span class="ͼe">checkout</span><span>,</span><br><span>nights:</span><span class="ͼe">nights</span><span>,</span><br><span>guests:</span><span class="ͼe">guests</span><br><span>}</span><br><br><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify(</span><span class="ͼe">data</span><span>)</span><br><span>})</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe