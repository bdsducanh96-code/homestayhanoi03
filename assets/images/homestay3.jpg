ll"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span class="ͼ6">// ===== XỬ LÝ FORM =====</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">form</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"bookingForm"</span><span>);</span><br><br><span class="ͼe">form</span><span class="ͼ8">.</span><span>addEventListener(</span><span class="ͼc">"submit"</span><span>,</span><span class="ͼ8">function</span><span>(</span><span class="ͼe">e</span><span>){</span><br><br><span class="ͼe">e</span><span class="ͼ8">.</span><span>preventDefault();</span><br><br><span class="ͼ6">// lấy dữ liệu form</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">ten</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"ten"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkin</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkin"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkout</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkout"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">khach</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"khach"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><br><span class="ͼ6">// tính số đêm</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d1</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkin</span><span>);</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d2</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkout</span><span>);</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">nights</span><span class="ͼ8">=</span><span>(</span><span class="ͼe">d2</span><span class="ͼ8">-</span><span class="ͼe">d1</span><span>)</span><span class="ͼ8">/</span><span>(</span><span class="ͼb">1000</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">24</span><span>);</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼe">nights</span><span class="ͼ8">&lt;=</span><span class="ͼb">0</span><span>){</span><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Ngày checkout phải sau checkin"</span><span>);</span><br><span class="ͼ8">return</span><span>;</span><br><span>}</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
