option&gt;</span><span>3</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>4</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>5</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;/select&gt;</span><br><br><span class="ͼ6">&lt;!-- nơi hiển thị kết quả sau khi khách submit --&gt;</span><br><span class="ͼg">&lt;div</span><span> </span><span class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"result"</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"ketqua"</span><span class="ͼg">&gt;&lt;/div&gt;</span><br><br><span class="ͼg">&lt;button</span><span> </span><span class="ͼf">type</span><span class="ͼ8">=</span><span class="ͼc">"submit"</span><span class="ͼg">&gt;</span><span>Kiểm tra phòng</span><span class="ͼg">&lt;/button&gt;</span><br><br><span class="ͼg">&lt;/form&gt;</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div><div class="flex w-full justify-end px-3 mt-1" data-code-block-feedback-row="true"></div></div></div></pre>
