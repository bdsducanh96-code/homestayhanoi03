="cm-scroller"><div class="cm-content q9tKkq_readonly"><span class="ͼ7">&lt;!DOCTYPE html&gt;</span><br><span class="ͼg">&lt;html&gt;</span><br><span class="ͼg">&lt;head&gt;</span><br><span class="ͼg">&lt;meta</span><span> </span><span class="ͼf">charset</span><span class="ͼ8">=</span><span class="ͼc">"UTF-8"</span><span class="ͼg">&gt;</span><br><span class="ͼg">&lt;title&gt;</span><span>Homestay Hà Nội</span><span class="ͼg">&lt;/title&gt;</span><br><br><span class="ͼg">&lt;style&gt;</span><br><span class="ͼg">body</span><span>{</span><br><span>font-family: </span><span class="ͼb">Arial</span><span>;</span><br><span>max-width:</span><span class="ͼb">500</span><span class="ͼ8">px</span><span>;</span><br><span>margin:</span><span class="ͼb">auto</span><span>;</span><br><span>padding:</span><span class="ͼb">40</span><span class="ͼ8">px</span><span>;</span><br><span>}</span><br><br><span class="ͼg">input</span><span>,</span><span class="ͼg">button</span><span>{</span><br><span>width:</span><span class="ͼb">100</span><span class="ͼ8">%</span><span>;</span><br><span>padding:</span><span class="ͼb">12</span><span class="ͼ8">px</span><span>;</span><br><span>margin-top:</span><span class="ͼb">10</span><span class="ͼ8">px</span><span>;</span><br><span>font-size:</span><span class="ͼb">16</span><span class="ͼ8">px</span><span>;</span><br><span>}</span><br><br><span class="ͼg">button</span><span>{</span><br><span>background:#0a7cff;</span><br><span>color:</span><span class="ͼb">white</span><span>;</span><br><span>border:</span><span class="ͼb">none</span><span>;</span><br><span>}</span><br><span class="ͼg">&lt;/style&gt;</span><br><br><span class="ͼg">&lt;/head&gt;</span><br><br><span class="ͼg">&lt;body&gt;</span><br><br><span class="ͼg">&lt;h1&gt;</span><span>🏡 Homestay Hà Nội</span><span class="ͼg">&lt;/h1&gt;</span><br><span class="ͼg">&lt;p&gt;</span><span>Điền nhanh thông tin để kiểm tra phòng trống</span><span class="ͼg">&lt;/p&gt;</span><br><br><span class="ͼg">&lt;input</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"name"</span><span> </span><span class="ͼf">placeholder</span><span class="ͼ8">=</span><span class="ͼc">"Tên của bạn"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;input</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"checkin"</span><span> </span><span class="ͼf">type</span><span class="ͼ8">=</span><span class="ͼc">"date"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;input</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"guests"</span><span> </span><span class="ͼf">placeholder</span><span class="ͼ8">=</span><span class="ͼc">"Số khách"</span><span class="ͼg">&gt;</span><br><br><span class="ͼg">&lt;button</span><span> </span><span class="ͼf">onclick</span><span class="ͼ8">=</span><span class="ͼc">"</span><span class="ͼe">submitForm</span><span>()</span><span class="ͼc">"</span><span class="ͼg">&gt;</span><span>Kiểm tra phòng</span><span class="ͼg">&lt;/button&gt;</span><br><br><span class="ͼg">&lt;p</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"status"</span><span class="ͼg">&gt;&lt;/p&gt;</span><br><br><span class="ͼg">&lt;script&gt;</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">API_URL</span><span> </span><span class="ͼ8">=</span><span> </span><span class="ͼc">"DÁN_LINK_APPS_SCRIPT_VÀO_ĐÂY"</span><br><br><span class="ͼ8">function</span><span> </span><span class="ͼe">submitForm</span><span>(){</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">data</span><span class="ͼ8">=</span><span>{</span><br><span>name:</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"name"</span><span>)</span><span class="ͼ8">.</span><span>value,</span><br><span>checkin:</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkin"</span><span>)</span><span class="ͼ8">.</span><span>value,</span><br><span>guests:</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"guests"</span><span>)</span><span class="ͼ8">.</span><span>value</span><br><span>}</span><br><br><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify(</span><span class="ͼe">data</span><span>)</span><br><span>})</span><br><span class="ͼ8">.</span><span>then(</span><span class="ͼe">r</span><span>=&gt;</span><span class="ͼe">r</span><span class="ͼ8">.</span><span>json())</span><br><span class="ͼ8">.</span><span>then(</span><span class="ͼe">res</span><span>=&gt;{</span><br><br><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"status"</span><span>)</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">"✅ Đã gửi! Chúng tôi sẽ phản hồi qua Zalo."</span><br><br><span>})</span><br><span>}</span><br><br><span class="ͼg">&lt;/script&gt;</span><br><br><span class="ͼg">&lt;/body&gt;</span><br><span class="ͼg">&lt;/html&gt;</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div><div class="flex w-full justify-end px-3 mt-1" data-code-block-feedback-row="true"></div></div></div></pre>
<hr data-start="2553" data-end="2556">
