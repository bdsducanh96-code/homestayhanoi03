<li data-start="323" data-end="364">
<p data-start="325" data-end="364"><span class="hover:entity-accent entity-underline inline cursor-pointer align-baseline"><span class="whitespace-normal">Google Sheets</span></span></p>
</li>
<li data-start="365" data-end="406">
<p data-start="367" data-end="406"><span class="hover:entity-accent entity-underline inline cursor-pointer align-baseline"><span class="whitespace-normal">Google Apps Script</span></span></p>
</li>
</ul>
