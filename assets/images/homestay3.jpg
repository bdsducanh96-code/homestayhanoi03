l"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify({</span><br><span>ten:</span><span class="ͼe">ten</span><span>,</span><br><span>checkin:</span><span class="ͼe">checkin</span><span>,</span><br><span>checkout:</span><span class="ͼe">checkout</span><span>,</span><br><span>khach:</span><span class="ͼe">khach</span><span>,</span><br><span>dem:</span><span class="ͼe">nights</span><br><span>})</span><br><span>})</span><br><span class="ͼ8">.</span><span>then(</span><span class="ͼe">response</span><span> =&gt; </span><span class="ͼe">response</span><span class="ͼ8">.</span><span>text())</span><br><span class="ͼ8">.</span><span>then(</span><span class="ͼe">data</span><span> =&gt; {</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">message</span><span class="ͼ8">=</span><span class="ͼc">`Xin chào Homestay Hà Nội</span><br><br><span class="ͼc">Tên: </span><span>${</span><span class="ͼe">ten</span><span>}</span><br><span class="ͼc">Checkin: </span><span>${</span><span class="ͼe">checkin</span><span>}</span><br><span class="ͼc">Checkout: </span><span>${</span><span class="ͼe">checkout</span><span>}</span><br><span class="ͼc">Số khách: </span><span>${</span><span class="ͼe">khach</span><span>}</span><br><span class="ͼc">Số đêm: </span><span>${</span><span class="ͼe">nights</span><span>}</span><span class="ͼc">`</span><span>;</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">url</span><span class="ͼ8">=</span><span class="ͼc">"https://zalo.me/"</span><span class="ͼ8">+</span><span class="ͼe">zalo</span><span class="ͼ8">+</span><span class="ͼc">"?text="</span><span class="ͼ8">+</span><span class="ͼe">encodeURIComponent</span><span>(</span><span class="ͼe">message</span><span>);</span><br><br><span class="ͼe">window</span><span class="ͼ8">.</span><span>location</span><span class="ͼ8">.</span><span>href</span><span class="ͼ8">=</span><span class="ͼe">url</span><span>;</span><br><br><span>});</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<p data-start="1132" data-end="1147">Điểm khác biệt:</p>
