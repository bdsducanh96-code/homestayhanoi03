<span class="ͼ8">=</span><span class="ͼc">"result"</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"ketqua"</span><span class="ͼg">&gt;&lt;/div&gt;</span><br><br><span class="ͼg">&lt;button</span><span> </span><span class="ͼf">type</span><span class="ͼ8">=</span><span class="ͼc">"submit"</span><span class="ͼg">&gt;</span><span>Kiểm tra phòng</span><span class="ͼg">&lt;/button&gt;</span><br><br><span class="ͼg">&lt;/form&gt;</span><br><br><span class="ͼg">&lt;/div&gt;</span><br><br><span class="ͼg">&lt;/div&gt;</span><br><br><span class="ͼg">&lt;script&gt;</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">API_URL</span><span class="ͼ8">=</span><span class="ͼc">"https://script.google.com/macros/s/AKfycbyKoQkT0Hdq_ixsYs03Ha1hr-nATncexSfDAn9mroSlVwZHBaEWNmdnMtAXMd_rmuPz/exec"</span><span>;</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">zalo</span><span class="ͼ8">=</span><span class="ͼc">"0365725659"</span><span>;</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">form</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"bookingForm"</span><span>);</span><br><br><span class="ͼe">form</span><span class="ͼ8">.</span><span>addEventListener(</span><span class="ͼc">"submit"</span><span>,</span><span class="ͼ8">function</span><span>(</span><span class="ͼe">e</span><span>){</span><br><br><span class="ͼe">e</span><span class="ͼ8">.</span><span>preventDefault();</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">ten</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"ten"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkin</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkin"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkout</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkout"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">khach</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"khach"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d1</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkin</span><span>);</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d2</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkout</span><span>);</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">nights</span><span class="ͼ8">=</span><span>(</span><span class="ͼe">d2</span><span class="ͼ8">-</span><span class="ͼe">d1</span><span>)</span><span class="ͼ8">/</span><span>(</span><span class="ͼb">1000</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">24</span><span>);</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼe">nights</span><span class="ͼ8">&lt;=</span><span class="ͼb">0</span><span>){</span><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Ngày checkout phải sau checkin"</span><span>);</span><br><span class="ͼ8">return</span><span>;</span><br><span>}</span><br><br><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"ketqua"</span><span>)</span><span class="ͼ8">.</span><span>innerText</span><span class="ͼ8">=</span><span class="ͼc">"Số đêm: "</span><span class="ͼ8">+</span><span class="ͼe">nights</span><span>;</span><br><br><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>mode:</span><span class="ͼc">"no-cors"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify({</span><br><span>ten:</span><span class="ͼe">ten</span><span>,</span><br><span>checkin:</span><span class="ͼe">checkin</span><span>,</span><br><span>checkout:</span><span class="ͼe">checkout</span><span>,</span><br><span>khach:</span><span class="ͼe">khach</span><span>,</span><br><span>dem:</span><span class="ͼe">nights</span><br><span>})</span><br><span>});</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">message</span><span class="ͼ8">=</span><span class="ͼc">`Xin chào Homestay Hà Nội</span><br><br><span class="ͼc">Tên: </span><span>${</span><span class="ͼe">ten</span><span>}</span><br><span class="ͼc">Checkin: </span><span>${</span><span class="ͼe">checkin</span><span>}</span><br><span class="ͼc">Checkout: </span><span>${</span><span class="ͼe">checkout</span><span>}</span><br><span class="ͼc">Số khách: </span><span>${</span><span class="ͼe">khach</span><span>}</span><br><span class="ͼc">Số đêm: </span><span>${</span><span class="ͼe">nights</span><span>}</span><span class="ͼc">`</span><span>;</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">url</span><span class="ͼ8">=</span><span class="ͼc">"https://zalo.me/"</span><span class="ͼ8">+</span><span class="ͼe">zalo</span><span class="ͼ8">+</span><span class="ͼc">"?text="</span><span class="ͼ8">+</span><span class="ͼe">encodeURIComponent</span><span>(</span><span class="ͼe">message</span><span>);</span><br><br><span class="ͼe">window</span><span class="ͼ8">.</span><span>location</span><span class="ͼ8">.</span><span>href</span><span class="ͼ8">=</span><span class="ͼe">url</span><span>;</span><br><br><span>});</span><br><br><span class="ͼg">&lt;/script&gt;</span><br><br><span class="ͼg">&lt;/body&gt;</span><br><br><span class="ͼg">&lt;/html&gt;</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div><div class="flex w-full justify-end px-3 mt-1" data-code-block-feedback-row="true"></div></div></div></pre>
<hr data-start="3215" data-end="3218">
<h1 data-start="3220" data-end="3236">Sau khi commit</h1>
<p data-start="3238" data-end="3254">Flow sẽ như sau:</p>
<pre class="overflow-visible! px-0!" data-start="3256" data-end="3367"><div class="relative w-full mt-4 mb-1"><div class=""><div class="relative"><div class="h-full min-h-0 min-w-0"><div class="h-full min-h-0 min-w-0" style="width: 100%; transform: none;"><div class="border border-token-border-light border-radius-3xl corner-superellipse/1.1 rounded-3xl"><div class="h-full w-full border-radius-3xl bg-token-bg-elevated-secondary corner-superellipse/1.1 overflow-clip rounded-3xl lxnfua_clipPathFallback"><div class="pointer-events-none absolute end-1.5 top-1 z-2 md:end-2 md:top-1"><button class="flex gap-1 items-center select-none pointer-events-auto py-2 text-sm font-medium hover:bg-black/5 dark:hover:bg-white/10 size-9 rounded-full px-2" aria-label="Copy" data-state="closed"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon-md"><use href="/cdn/assets/sprites-core-fk4oovux.svg#ce3544" fill="currentColor"></use></svg></button></div><div class="pe-11 pt-3" style="transform: none;"><div class="relative z-0 flex max-w-full"><div id="code-block-viewer" dir="ltr" class="q9tKkq_viewer cm-editor z-10 light:cm-light dark:cm-light flex h-full w-full flex-col items-stretch ͼ5 ͼj"><div class="cm-scroller"><div class="cm-content q9tKkq_readonly"><span>TikTok</span><br><span>↓</span><br><span>link bio</span><br><span>↓</span><br><span>website booking</span><br><span>↓</span><br><span>khách điền form</span><br><span>↓</span><br><span>Zalo mở ngay (&lt;1s)</span><br><span>↓</span><br><span>Google Sheet lưu thông tin</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div></div></div></pre>
<p data-start="3369" data-end="3428">Trang này chịu được <strong data-start="3389" data-end="3415">traffic TikTok rất lớn</strong> vì chỉ dùng:</p>
<ul data-start="3430" data-end="3567">
<li data-start="3430" data-end="3479">
<p data-start="3432" data-end="3479"><strong data-start="3432" data-end="3479"><span class="hover:entity-accent entity-underline inline cursor-pointer align-baseline"><span class="whitespace-normal">GitHub</span></span> Pages</strong></p>
</li>
<li data-start="3480" data-end="3523">
<p data-start="3482" data-end="3523"><strong data-start="3482" data-end="3523"><span class="hover:entity-accent entity-underline inline cursor-pointer align-baseline"><span class="whitespace-normal">Google Apps Script</span></span></strong></p>
</li>
<li data-start="3524" data-end="3567">
<p data-start="3526" data-end="3567"><strong data-start="3526" data-end="3567"><span class="hover:entity-accent entity-underline inline cursor-pointer align-baseline"><span class="whitespace-normal">Google Sheets</span></span></strong></p>
</li>
</ul>
<p data-start="3569" data-end="3594">→ hoàn toàn <strong data-start="3581" data-end="3593">miễn phí</strong>.</p>
<hr data-start="3596" data-end="3599">
<p data-start="3601" data-end="3684">💡 Nếu bạn muốn, tôi có thể giúp bạn nâng cấp thêm 3 thứ rất đáng giá cho homestay:</p>
<p data-start="3686" data-end="3821">1️⃣ <strong data-start="3690" data-end="3724">Calendar chọn ngày kiểu Airbnb</strong> (rất đẹp)<br data-start="3734" data-end="3737">
2️⃣ <strong data-start="3741" data-end="3774">Tự tính giá phòng theo số đêm</strong><br data-start="3774" data-end="3777">
3️⃣ <strong data-start="3781" data-end="3821">Hiển thị phòng còn trống / hết phòng</strong></p>
<p data-start="3823" data-end="3924" data-is-last-node="" data-is-only-node="">Những trang booking TikTok lớn thường dùng bộ này để <strong data-start="3876" data-end="3923">tăng conversion khách nhắn Zalo thêm 40–60%</strong>.</p></div></div></div></div><div class="z-0 flex min-h-[46px] justify-start"><div class="touch:-me-2 touch:-ms-3.5 -ms-2.5 -me-1 flex flex-wrap items-center gap-y-4 p-1 select-none touch:w-[calc(100%+--spacing(3.5))] -mt-1 w-[calc(100%+--spacing(2.5))] duration-[1.5s] focus-within:transition-none hover:transition-none touch:pointer-events-auto pointer-events-none [mask-image:linear-gradient(to_right,black_33%,transparent_66%)] [mask-size:300%_100%] [mask-position:100%_0%] motion-safe:transition-[mask-position] group-hover/turn-messages:pointer-events-auto group-hover/turn-messages:[mask-position:0_0] group-focus-within/turn-messages:pointer-events-auto group-focus-within/turn-messages:[mask-position:0_0] has-data-[state=open]:pointer-events-auto has-data-[state=open]:[mask-position:0_0]" style="mask-position: 0% 0%;"><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Copy" aria-pressed="false" data-testid="copy-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-fk4oovux.svg#ce3544" fill="currentColor"></use></svg></span></button><button class="text-token-text-secondary hover:bg-token-bg-secondary rounded-lg" aria-label="Good response" aria-pressed="false" data-testid="good-response-turn-action-button" data-state="closed"><span class="flex items-center justify-center touch:w-10 h-8 w-8"><svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" aria-hidden="true" class="icon"><use href="/cdn/assets/sprites-core-fk4oovux.svg#51753c" fill="currentColor"></use></svg></span></button><button class="text-token-text-seconda