8">.</span><span>value;</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 8: TÍNH SỐ ĐÊM</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d1</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkin</span><span>);</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d2</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkout</span><span>);</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">nights</span><span class="ͼ8">=</span><span>(</span><span class="ͼe">d2</span><span class="ͼ8">-</span><span class="ͼe">d1</span><span>)</span><span class="ͼ8">/</span><span>(</span><span class="ͼb">1000</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">24</span><span>);</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼe">nights</span><span class="ͼ8">&lt;=</span><span class="ͼb">0</span><span>){</span><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Ngày checkout phải sau checkin"</span><span>);</span><br><span class="ͼ8">return</span><span>;</span><br><span>}</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 9: LƯU GOOGLE SHEET</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>mode:</span><span class="ͼc">"no-cors"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify({</span><br><span>ten:</span><span class="ͼe">ten</span><span>,</span><br><span>checkin:</span><span class="ͼe">checkin</s