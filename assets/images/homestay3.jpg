><span>Số khách</span><span class="ͼg">&lt;/label&gt;</span><br><br><span class="ͼg">&lt;select</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"khach"</span><span class="ͼg">&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>1</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>2</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>3</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>4</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;option&gt;</span><span>5</span><span class="ͼg">&lt;/option&gt;</span><br><span class="ͼg">&lt;/select&gt;</span><br><br><span class="ͼ6">&lt;!-- nơi hiển thị kết quả --&gt;</span><br><span class="ͼg">&lt;div</span><span> </span><span class="ͼf">class</span><span class="ͼ8">=</span><span class="ͼc">"result"</span><span> </span><span class="ͼf">id</span><span class="ͼ8">=</span><span class="ͼc">"ketqua"</span><span class="ͼg">&gt;&lt;/div&gt;</span><br><br><span class="ͼg">&lt;button</span><span> </span><span class="ͼf">type</span><span class="ͼ8">=</span><span class="ͼc">"submit"</span><span class="ͼg">&gt;</span><span>Kiểm tra phòng</span><span class="ͼg">&lt;/button&gt;</span><br><br><span class="ͼg">&lt;/form&gt;</span><br><br><span class="ͼg">&lt;/div&gt;</span><br><span class="ͼg">&lt;/div&gt;</span><br><br><span class="ͼg">&lt;script&gt;</span><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 4: CẤU HÌNH HỆ THỐNG</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ6">// API lưu dữ liệu vào Google Sheet</span><br><span class="ͼ8">const</span><span> </span><span class="ͼe">API_URL</span><span class="ͼ8">=</span><span class="ͼc">"https://script.google.com/macros/s/AKfycbyKoQkT0Hdq_ixsYs03Ha1hr-nATncexSfDAn9mroSlVwZHBaEWNmdnMtAXMd_rmuPz/exec"</span><span>;</span><br><br><span class="ͼ6">// số Zalo nhận booking</span><br><span class="ͼ8">const</span><span> </span><span class="ͼe">zalo</span><span class="ͼ8">=</span><span class="ͼc">"0365725659"</span><span>;</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 5: XỬ LÝ SUBMIT FORM</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ8">const</span><span> </span><span class="ͼe">form</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"bookingForm"</span><span>);</span><br><br><span class="ͼe">form</span><span class="ͼ8">.</span><span>addEventListener(</span><span class="ͼc">"submit"</span><span>,</span><span class="ͼ8">function</span><span>(</span><span class="ͼe">e</span><span>){</span><br><br><span class="ͼe">e</span><span class="ͼ8">.</span><span>preventDefault();</span><br><br><span class="ͼ6">/* lấy dữ liệu từ form */</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">ten</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"ten"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkin</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkin"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">checkout</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"checkout"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">khach</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"khach"</span><span>)</span><span class="ͼ8">.</span><span>value;</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 6: TÍNH SỐ ĐÊM</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d1</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkin</span><span>);</span><br><span class="ͼ8">let</span><span> </span><span class="ͼe">d2</span><span class="ͼ8">=new</span><span> </span><span class="ͼe">Date</span><span>(</span><span class="ͼe">checkout</span><span>);</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">nights</span><span class="ͼ8">=</span><span>(</span><span class="ͼe">d2</span><span class="ͼ8">-</span><span class="ͼe">d1</span><span>)</span><span class="ͼ8">/</span><span>(</span><span class="ͼb">1000</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">60</span><span class="ͼ8">*</span><span class="ͼb">24</span><span>);</span><br><br><span class="ͼ8">if</span><span>(</span><span class="ͼe">nights</span><span class="ͼ8">&lt;=</span><span class="ͼb">0</span><span>){</span><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Ngày checkout phải sau checkin"</span><span>);</span><br><span class="ͼ8">return</span><span>;</span><br><span>}</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 7: LƯU DATA VÀO GOOGLE SHEET</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼe">fetch</span><span>(</span><span class="ͼe">API_URL</span><span>,{</span><br><span>method:</span><span class="ͼc">"POST"</span><span>,</span><br><span>mode:</span><span class="ͼc">"no-cors"</span><span>,</span><br><span>body:</span><span class="ͼe">JSON</span><span class="ͼ8">.</span><span>stringify({</span><br><span>ten:</span><span class="ͼe">ten</span><span>,</span><br><span>checkin:</span><span class="ͼe">checkin</span><span>,</span><br><span>checkout:</span><span class="ͼe">checkout</span><span>,</span><br><span>khach:</span><span class="ͼe">khach</span><span>,</span><br><span>dem:</span><span class="ͼe">nights</span><br><span>})</span><br><span>});</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 8: TẠO NỘI DUNG TIN NHẮN</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">message</span><span class="ͼ8">=</span><span class="ͼc">`Xin chào Homestay Hà Nội</span><br><br><span class="ͼc">Tên: </span><span>${</span><span class="ͼe">ten</span><span>}</span><br><span class="ͼc">Checkin: </span><span>${</span><span class="ͼe">checkin</span><span>}</span><br><span class="ͼc">Checkout: </span><span>${</span><span class="ͼe">checkout</span><span>}</span><br><span class="ͼc">Số khách: </span><span>${</span><span class="ͼe">khach</span><span>}</span><br><span class="ͼc">Số đêm: </span><span>${</span><span class="ͼe">nights</span><span>}</span><span class="ͼc">`</span><span>;</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 9: HIỂN THỊ COPY + MỞ ZALO</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"ketqua"</span><span>)</span><span class="ͼ8">.</span><span>innerHTML</span><span class="ͼ8">=</span><span class="ͼc">`</span><br><br><span class="ͼc">&lt;p&gt;&lt;b&gt;Thông tin đặt phòng&lt;/b&gt;&lt;/p&gt;</span><br><br><span class="ͼc">&lt;textarea id="msgbox"&gt;</span><span>${</span><span class="ͼe">message</span><span>}</span><span class="ͼc">&lt;/textarea&gt;</span><br><br><span class="ͼc">&lt;button onclick="copyMsg()"&gt;Copy nội dung&lt;/button&gt;</span><br><br><span class="ͼc">&lt;button onclick="openZalo()"&gt;Mở Zalo gửi&lt;/button&gt;</span><br><br><span class="ͼc">`</span><span>;</span><br><br><span>});</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 10: COPY NỘI DUNG</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ8">function</span><span> </span><span class="ͼe">copyMsg</span><span>(){</span><br><br><span class="ͼ8">let</span><span> </span><span class="ͼe">text</span><span class="ͼ8">=</span><span class="ͼe">document</span><span class="ͼ8">.</span><span>getElementById(</span><span class="ͼc">"msgbox"</span><span>);</span><br><br><span class="ͼe">text</span><span class="ͼ8">.</span><span>select();</span><br><br><span class="ͼe">navigator</span><span class="ͼ8">.</span><span>clipboard</span><span class="ͼ8">.</span><span>writeText(</span><span class="ͼe">text</span><span class="ͼ8">.</span><span>value);</span><br><br><span class="ͼe">alert</span><span>(</span><span class="ͼc">"Đã copy nội dung. Hãy mở Zalo và dán gửi."</span><span>);</span><br><br><span>}</span><br><br><br><span class="ͼ6">/* =========================</span><br><span class="ͼ6">BLOCK 11: MỞ ZALO</span><br><span class="ͼ6">========================= */</span><br><br><span class="ͼ8">function</span><span> </span><span class="ͼe">openZalo</span><span>(){</span><br><br><span class="ͼe">window</span><span class="ͼ8">.</span><span>location</span><span class="ͼ8">.</span><span>href</span><span class="ͼ8">=</span><span class="ͼc">"https://zalo.me/"</span><span class="ͼ8">+</span><span class="ͼe">zalo</span><span>;</span><br><br><span>}</span><br><br><span class="ͼg">&lt;/script&gt;</span><br><br><span class="ͼg">&lt;/body&gt;</span><br><br><span class="ͼg">&lt;/html&gt;</span></div></div></div></div></div></div></div></div></div><div class=""><div class="" style="width: 100%; transform: none;"></div></div></div><div class="flex w-full justify-end px-3 mt-1" data-code-block-feedback-row="true"></div></div></div></pre>
